// Masked Project Showcases
const portfolioProjects = [
  {
    title: 'Adaptive OSW Production Tracking Ecosystem',
    category: 'Full-Stack .NET Core + Angular + SignalR Real-Time Platform',
    clientContext: 'Aerospace Final Assembly & Structural Integration',
    summary: 'A mission-critical shop-floor execution and labor visibility web application engineered to handle volatile, non-standard assembly tasks (OSW). Connects shop-floor mechanics directly to real-time TV boards and executive approval portals.',
    highlights: [
      'Engineered multi-tier architecture using ASP.NET Core Web API, Angular 19, Entity Framework Core, and real-time SignalR broadcasts.',
      'Touch/non-touch labor tracking and automated job-kit readiness verification across multi-station aircraft assembly.',
      'Dedicated Kiosk interface for shop mechanics and high-visibility TV Board display for floor management.',
      'Integrated manager sign-off portal with automated variance detection against SAP production orders.'
    ],
    images: [
      { src: '/images/portfolio/OSW_Tracker_TV.png', label: 'Shop-Floor TV Monitoring Board (Real-Time Status, Masked)' },
