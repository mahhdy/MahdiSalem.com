    highlights: [
      'Automated nightly and intra-day cross-database reconciliation, flagging BOM discrepancies, orphan jobs, and scrap variances.',
      'Constructed a unified Data Quality KPI Framework delivering 100% data auditability to PMO and QA executive teams.',
      'Optimized heavy ETL throughput, slashing database lock contention and reducing package runtimes by over 70%.'
    ],
    privacyNotice: 'Proprietary enterprise schemas, server endpoints, and internal database connection details are protected under NDA.'
  },
  {
    title: 'Rapid-Response Shop-Floor Automation & Alerting Suite',
    category: 'Python + VBA + PowerApps + Power Automate',
    clientContext: 'Aerospace & High-Precision Manufacturing',
    summary: 'Designed and deployed rapid-response automation tools that eliminated administrative friction and bridge critical ERP workflow gaps across engineering, supply chain, and shop-floor operations.',
    highlights: [
      'Automated Crew Load Chart generation with VBA & Python, reducing daily processing time by 98.8% (from 3 hours down to 2 minutes).',
      'Automated Non-Conformance (RNC) reporting tool that generated root-cause dossiers in 3 minutes without manual re-entry.',
      'Digitized Daily Management Meeting (DMM) reporting into an interactive dashboard, improving reporting efficiency by 200%.'
    ],
    privacyNotice: 'Operational performance formulas and proprietary supplier records have been anonymized.'
  },
