  <!-- Client-side Tab & Lightbox JavaScript -->
  <script is:inline>
    // Tab Switching for Certificates
    const tabBtns = document.querySelectorAll('.cert-tab-btn');
    const tabPanes = document.querySelectorAll('.cert-pane');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-category-target');
        
        tabBtns.forEach(b => {
          b.classList.remove('bg-primary', 'text-white', 'shadow-sm');
          b.classList.add('bg-surface-dim', 'dark:bg-surface-dark-dim', 'text-text-muted', 'dark:text-text-dark-muted');
        });
        btn.classList.add('bg-primary', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-surface-dim', 'dark:bg-surface-dark-dim', 'text-text-muted', 'dark:text-text-dark-muted');

        tabPanes.forEach(pane => {
          if (pane.id === `cat-pane-${targetId}`) {
            pane.classList.remove('hidden');
            pane.classList.add('block');
          } else {
            pane.classList.remove('block');
            pane.classList.add('hidden');
          }
        });
      });
    });

    // Lightbox Modal Logic
    const lightbox = document.getElementById('image-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxBadge = document.getElementById('lightbox-badge-link');
    const lightboxDirect = document.getElementById('lightbox-direct-link');
    const closeBtn = document.getElementById('close-lightbox');

    function openModal(imgSrc, title, badgeUrl) {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = imgSrc;
      lightboxTitle.textContent = title || '';
      lightboxDirect.href = imgSrc;

      if (badgeUrl && badgeUrl.length > 5) {
        lightboxBadge.href = badgeUrl;
        lightboxBadge.classList.remove('hidden');
      } else {
        lightboxBadge.classList.add('hidden');
      }

      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.open-lightbox').forEach(el => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const imgSrc = el.getAttribute('data-img') || el.getAttribute('src');
        const title = el.getAttribute('data-title') || el.getAttribute('alt');
        const badge = el.getAttribute('data-badge') || '';
        if (imgSrc) openModal(imgSrc, title, badge);
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeModal();
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  </script>
